<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/blue">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="16dp" android:text="@string/post_match"
        android:textSize="28sp" android:textStyle="bold" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/outcome_label" android:textSize="20sp" />
            <RadioGroup android:id="@+id/outcomeGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/outcomeW" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/outcome_win" />
                <RadioButton android:id="@+id/outcomeD" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/outcome_draw" />
                <RadioButton android:id="@+id/outcomeL" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/outcome_loss" />
            </RadioGroup>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/ranking_points" android:textSize="20sp" />
            <com.joshualee0902.myapplication.CounterView android:id="@+id/RankingPoints"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <CheckBox android:id="@+id/checkBricked" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/bricked" android:textSize="20sp" />
            <TextView android:id="@+id/totalPointsAuto" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:textSize="20sp" />
            <EditText android:id="@+id/Comment" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:hint="@string/add_comment" android:inputType="textMultiLine" android:minLines="2" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp">
        <Button android:id="@+id/back3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/back_page" />
        <Button android:id="@+id/next4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/submit" />
    </LinearLayout>
</LinearLayout>
