<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/red">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="16dp" android:text="@string/match_teleop"
        android:textSize="28sp" android:textStyle="bold" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/upper_score" android:textSize="20sp" />
            <com.joshualee0902.myapplication.CounterView android:id="@+id/TeleUpper"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/lower_score" android:textSize="20sp" />
            <com.joshualee0902.myapplication.CounterView android:id="@+id/TeleLower"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/wheel" android:textSize="20sp" />
            <CheckBox android:id="@+id/checkWheelSpin" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/spin" android:textSize="20sp" />
            <CheckBox android:id="@+id/checkWheelColor" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/color" android:textSize="20sp" />
            <CheckBox android:id="@+id/checkClimb" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/climb" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/foul" android:textSize="20sp" />
            <com.joshualee0902.myapplication.CounterView android:id="@+id/Fouls"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/defense_rating" android:textSize="20sp" />
            <RadioGroup android:id="@+id/defenseGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal">
                <RadioButton android:id="@+id/defense0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/defense_none" />
                <RadioButton android:id="@+id/defense1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/defense_light" />
                <RadioButton android:id="@+id/defense2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/defense_medium" />
                <RadioButton android:id="@+id/defense3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/defense_heavy" />
            </RadioGroup>
            <CheckBox android:id="@+id/checkDefended" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/defended_against" android:textSize="20sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp">
        <Button android:id="@+id/back2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="8dp" android:text="@string/back_page" />
        <Button android:id="@+id/next3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/next_page" />
    </LinearLayout>
</LinearLayout>
